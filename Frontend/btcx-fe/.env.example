# =============================================================================
# Application Configuration - Example
# =============================================================================
# Copy this file to .env and fill in the values for local development.
# The .env file is ignored by git.

# Authentication
# Set to "true" to enable auth, "false" to disable (default for local dev)
VITE_AUTH_ENABLED=false

# Database
# Postgres connection string - platform injects on deploy
# Local development: leave empty to use PGLite fallback
# Example: postgres://user:password@localhost:5432/dbname
DATABASE_URL=

# =============================================================================
# Grok Platform Integration
# =============================================================================

# Grok project ID - injected by platform on deploy
GROK_PROJECT_ID=

# Public hostname for published apps (used in OG tags)
# Platform injects on deploy; local preview uses request Host
VITE_PUBLIC_HOSTNAME=

# Project ID for client-side Grok integrations
VITE_PROJECT_ID=

# OG (Open Graph) service URL
# Default: https://og.grok.me
VITE_OG_SERVICE_URL=https://og.grok.me

# Creator metadata for x:creator meta tags
X_CREATOR=
X_CREATOR_ID=

# Auth Broker Configuration (injected by platform on deploy)
# These are used for federated sign-in via the Grok auth broker
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# Better Auth URL (injected by platform on deploy)
BETTER_AUTH_URL=

# Connectors service configuration
# Connector service URL (for AI connectors)
GROK_CONNECTORS_URL=

# Connector access token (development only - not used in production)
# Used for local testing of connector functionality
GROK_CONNECTOR_ACCESS_TOKEN=

# Gate origin override
GROK_GATE_ORIGIN=

# =============================================================================
# AI Services
# =============================================================================

# xAI API key for server-side AI calls
# WARNING: This spends the app owner's quota
XAI_API_KEY=

# =============================================================================
# BTCX API Configuration
# =============================================================================

# BTCX API base URL for the Bitcoin Transaction API
# Default: https://btcx-api.fly.dev
BTCX_API_URL=https://btcx-api.fly.dev

# BTCX API endpoint path
# Default: /create_tx
BTCX_API_ENDPOINT=/create_tx

# =============================================================================
# Node Environment
# =============================================================================

# Node.js environment mode (development, production, etc.)
# Set by npm scripts automatically, but can be overridden
NODE_ENV=development

# =============================================================================
# Network Configuration
# =============================================================================

# STUN server URLs for WebRTC (comma-separated)
# Default: Google public STUN servers
# Uncomment and customize if needed:
# VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478

# =============================================================================
# Development/Preview Settings
# =============================================================================

# Preview server port (used by scripts/preview.mjs)
PREVIEW_PORT=8081

# Timeout for preview server to become ready (ms)
PREVIEW_READY_TIMEOUT_MS=60000

# Timeout for preview thumbnail generation (ms)
PREVIEW_THUMBNAIL_TIMEOUT_MS=45000

# =============================================================================
# Browser Test Settings
# =============================================================================

# Timeout for browser smoke tests (ms)
BROWSER_SMOKE_TIMEOUT_MS=45000

# Baseline file for browser smoke verdict comparison
BROWSER_SMOKE_BASELINE=

# Allow browser to navigate to external hosts (not just loopback)
# Set to "1" to enable, useful for testing against staging/production
BROWSER_ALLOW_EXTERNAL_HOST=0
